{
  "openapi": "3.1.0",
  "info": {
    "title": "QR Transceiver local API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:38475"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v1/status": {
      "get": {
        "summary": "Read engine status",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation or permission error"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/v1/devices": {
      "get": {
        "summary": "Enumerate USB webcams",
        "operationId": "devices",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation or permission error"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/v1/transfers": {
      "get": {
        "summary": "List transfer jobs",
        "operationId": "transfers",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation or permission error"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/v1/transfers/{id}": {
      "get": {
        "summary": "Read transfer integrity and progress",
        "operationId": "transfer",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation or permission error"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/v1/transfers/files": {
      "post": {
        "summary": "Snapshot permitted files",
        "operationId": "sendFiles",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "paths"
                ],
                "properties": {
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 4096
                  },
                  "recursive": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation or permission error"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/v1/transfers/directory": {
      "post": {
        "summary": "Snapshot permitted directory",
        "operationId": "sendDirectory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "paths"
                ],
                "properties": {
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "recursive": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation or permission error"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/v1/transfers/{id}/{action}": {
      "post": {
        "summary": "Pause, resume or cancel a transfer",
        "operationId": "transferAction",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "action",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "pause",
                "resume",
                "cancel",
                "restart",
                "remove"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation or permission error"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/v1/receive/start": {
      "post": {
        "summary": "Start continuous webcam reception",
        "operationId": "startReceiver",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation or permission error"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "summary": "Authenticated event stream",
        "operationId": "events",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation or permission error"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/v1/settings/profiles": {
      "get": {
        "summary": "List saved profiles",
        "operationId": "profiles",
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation or permission error"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/v1/rpc": {
      "post": {
        "summary": "Local engine command",
        "operationId": "rpc",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "method"
                ],
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "params": {}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation or permission error"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    }
  }
}