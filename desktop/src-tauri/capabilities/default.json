{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Local transceiver windows",
  "windows": [
    "main",
    "qr-display"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "core:window:allow-set-fullscreen",
    "core:window:allow-available-monitors",
    "core:window:allow-is-fullscreen",
    "core:event:default"
  ]
}